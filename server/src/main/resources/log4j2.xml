<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{HH:mm:ss.SSS} [%-20t] %-35c{2.} %-5p rid=%X{requestId} %m%n" />
		</Console>
	</Appenders>
	<Loggers>
		<!-- BlackLab's own code: keep at INFO so any issues are visible -->
		<Logger name="nl.inl" level="info" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<!-- Suppress Lucene/Solr startup INFO messages that are routed here via log4j-jul -->
		<Logger name="org.apache.lucene" level="warn" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<!-- Everything else (third-party libraries) at INFO to reduce noise -->
		<Root level="info">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
